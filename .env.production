# Production YumPals feature flags, loaded by Vite for `npm run build` and `npm run deploy`.
# These are public build switches, not secrets. Changing them changes the live site.
VITE_YUMPALS_PAID_CARE=enabled
VITE_YUMPALS_SAVED_GAME=enabled
VITE_YUMPALS_PAID_CONTROLS=enabled
# Donut pal: 'teacher' = only the teacher account sees it; 'enabled' = everyone.
VITE_YUMPALS_POCKET=teacher
