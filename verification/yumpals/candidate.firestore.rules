rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Non-artifacts documents keep the exact baseline public-read/auth-write behavior.
    match /{collection}/{id}/{rest=**} {
      allow read: if collection != 'artifacts';
      allow write: if collection != 'artifacts' && request.auth != null;
    }

    // The artifacts app document itself remains public-readable/auth-writable.
    match /artifacts/{appId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // The only protected branch is artifacts/yum-donut-school/yumpals/**.
    // This partition has no broad allow overlapping the protected branch.
    match /artifacts/{appId}/{section}/{rest=**} {
      allow read: if appId != 'yum-donut-school' || section != 'yumpals';
      allow write: if (appId != 'yum-donut-school' || section != 'yumpals')
        && request.auth != null;
    }
  }
}
